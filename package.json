{
  "name": "urx-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command line control and inspection for YAMAHA URX series audio interfaces",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.7.1+sha512.2d92c86b7928dc8284f53494fb4201f983da65f0fb4f0d40baafa5cf628fa31dae3e5968f12466f17df7e97310e30f343a648baea1b9b350685dafafffdf5808",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "napi": {
    "binaryName": "urx-native"
  },
  "scripts": {
    "build": "pnpm build:common && tsc -p tsconfig.json && node scripts/build-info.mjs",
    "typecheck": "pnpm build:common && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build-inputs:check": "node scripts/build-inputs.mjs",
    "build:native": "node scripts/build-native.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:write": "node scripts/version.mjs --write",
    "build:release": "node scripts/release-build.mjs",
    "build:common": "tsc -p vendor/urx-device/packages/control/tsconfig.json"
  },
  "dependencies": {
    "@urx/device-control": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.11.0",
    "@types/node": "26.6.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
