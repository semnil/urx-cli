# No pattern carries a trailing slash: a trailing slash matches directories only,
# so `node_modules/` would not ignore a `node_modules` symlink, which is how a
# shared install gets committed from a git worktree.
node_modules
dist
dist-release*
dist-bundle*
target
coverage
